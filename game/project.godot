; Alphabet Island — first playable, Godot 4.7
config_version=5

[application]
config/name="字母岛 · 我的第一天"
config/version="0.12.0-dev"
config/icon="res://assets/icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
State="*res://scripts/game_state.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=960
window/size/min_height=640
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.69, 0.81, 0.77, 1)

[audio]
driver/enable_input=false
